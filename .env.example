ZUKI_API_BASE_URL=https://zuki-api.example.com
# Human test recipient, E.164. Never the real cafe or inbound assistant number.
ZUKI_TEST_TRANSFER_NUMBER=
# Save the printed IDs here to PATCH the same resources on subsequent runs.
VAPI_LOOKUP_TOOL_ID=
VAPI_ASSISTANT_ID=
